                // Package details string
                let pkgDetails = '';
                if(formData.packages.pkg1.selected) pkgDetails += `<p>- เงินสนับสนุน 20,000 บาท/booth จำนวน ${formData.packages.pkg1.qty} booth (รวม ${(20000 * formData.packages.pkg1.qty).toLocaleString()} บาท)</p>`;
                if(formData.packages.pkg2.selected) pkgDetails += `<p>- เงินสนับสนุน 40,000 บาท/booth จำนวน ${formData.packages.pkg2.qty} booth (รวม ${(40000 * formData.packages.pkg2.qty).toLocaleString()} บาท)</p>`;
                if(formData.packages.pkg3.selected) pkgDetails += `<p>- เงินสนับสนุน lunch symposium 200,000 บาท</p>`;

