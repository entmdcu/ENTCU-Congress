        // Form Submit
        document.getElementById('registration-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            if (!isAuthReady || !auth.currentUser) {
                showModal('error', 'ข้อผิดพลาด', 'ระบบยังไม่พร้อมใช้งาน กรุณารอสักครู่แล้วลองใหม่');
                return;
            }

            // Validation: at least one package selected
            if (!pkgs.some(p => p.check.checked)) {
                showModal('error', 'ข้อมูลไม่ครบถ้วน', 'กรุณาเลือกแพ็กเกจการสนับสนุนอย่างน้อย 1 รายการ');
                return;
            }

            const paymentMethod = document.querySelector('input[name="payment_method"]:checked').value;
            
            // Calculate Total
            let totalAmount = 0;
            if (pkgs[0].check.checked) totalAmount += pkgs[0].price * parseInt(pkgs[0].qty.value);
            if (pkgs[1].check.checked) totalAmount += pkgs[1].price * parseInt(pkgs[1].qty.value);
            if (pkgs[2].check.checked) totalAmount += pkgs[2].price;

            // Prepare Data
            const formData = {
                contact: {
                    name: document.getElementById('r_name').value,
                    position: document.getElementById('r_position').value,
                    company: document.getElementById('r_company').value,
                    address: document.getElementById('r_address').value,
                    phone: document.getElementById('r_phone').value,
                    fax: document.getElementById('r_fax').value,
                    email: document.getElementById('r_email').value,
                },
                packages: {
                    pkg1: { selected: pkgs[0].check.checked, qty: parseInt(pkgs[0].qty.value) || 0 },
                    pkg2: { selected: pkgs[1].check.checked, qty: parseInt(pkgs[1].qty.value) || 0 },
                    pkg3: { selected: pkgs[2].check.checked }
                },
                payment: {
                    method: paymentMethod,
                    cheque: paymentMethod === 'cheque' ? {
                        bank: document.getElementById('cq_bank').value,
                        branch: document.getElementById('cq_branch').value,
                        number: document.getElementById('cq_number').value,
                        date: document.getElementById('cq_date').value
                    } : null
                },
                totalAmount: totalAmount,
                createdAt: new Date().toISOString(),
                status: 'pending',
                slipImage: null // for later upload
            };

            // Generate Booking ID (ENT27-XXXX)
            const randomNum = Math.floor(1000 + Math.random() * 9000);
            const bookingId = `ENT27-${randomNum}`;
            formData.bookingId = bookingId;

            showLoading('กำลังบันทึกข้อมูลและสร้างเอกสาร...');

            try {
                // Save to Firestore (CRITICAL RULE 1: Strict Paths)
                // Path: /artifacts/{appId}/public/data/sponsorships/{bookingId}
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'sponsorships', bookingId);
                await setDoc(docRef, formData);

                // Generate PDF
                await generateAndDownloadPDF(bookingId, formData, totalAmount);
                
                hideLoading();
                
                // Show Success
                showModal('success', 'จองพื้นที่สำเร็จ', 
                    `รหัสใบจองของคุณคือ <strong><span class="text-xl text-chula">${bookingId}</span></strong><br><br>
                    ระบบได้ดาวน์โหลดเอกสาร PDF ลงในเครื่องของคุณแล้ว <br>
                    กรุณาใช้รหัสใบจองนี้ในการอัปโหลดหลักฐานการชำระเงินในภายหลัง`, 
                    () => {
                        // Reset form
                        document.getElementById('registration-form').reset();
                        pkgs.forEach(pkg => { if(pkg.qty) pkg.qty.disabled = true; });
                        updateTotal();
                        // Optional: Switch to slip tab and prefill ID
                        tabSlipBtn.click();
                        document.getElementById('search_booking_id').value = bookingId;
                    }
                );

            } catch (error) {
                console.error("Error saving document: ", error);
                hideLoading();
                showModal('error', 'เกิดข้อผิดพลาด', 'ไม่สามารถบันทึกข้อมูลได้ กรุณาลองใหม่อีกครั้ง');
            }
        });

        
        let currentUploadBookingId = null;
        const uploadSection = document.getElementById('upload_section');
        const alertBox = document.getElementById('upload_alert');
        let compressedBase64 = null;

        function showAlert(msg, isError = false) {
            alertBox.classList.remove('hidden', 'bg-green-100', 'text-green-800', 'bg-red-100', 'text-red-800');
            alertBox.classList.add(isError ? 'bg-red-100' : 'bg-green-100', isError ? 'text-red-800' : 'text-green-800');
            alertBox.innerText = msg;
        }

        function hideAlert() {
            alertBox.classList.add('hidden');
        }

        // Search Booking
        document.getElementById('search-btn').addEventListener('click', async () => {
            const searchId = document.getElementById('search_booking_id').value.trim().toUpperCase();
            if (!searchId) {
                showModal('error', 'แจ้งเตือน', 'กรุณากรอกรหัสใบจอง');
                return;
            }

            if (!isAuthReady || !auth.currentUser) return;

            showLoading('กำลังค้นหาข้อมูล...');
            hideAlert();

            try {
                // CRITICAL RULE 1: Strict Paths
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'sponsorships', searchId);
                const docSnap = await getDoc(docRef);

                hideLoading();

                if (docSnap.exists()) {
                    const data = docSnap.data();
                    currentUploadBookingId = searchId;
                    
                    // Display Data
                    document.getElementById('disp_booking_id').innerText = data.bookingId;
                    document.getElementById('disp_company').innerText = data.contact.company;
                    document.getElementById('disp_name').innerText = data.contact.name;
                    document.getElementById('disp_total').innerText = data.totalAmount.toLocaleString() + ' บาท';
                    
                    // Reset upload state
                    resetUploadState();
                    
                    if (data.slipImage) {
                        showAlert('ใบจองนี้มีการอัปโหลดสลิปแล้ว คุณสามารถอัปโหลดใหม่เพื่อแทนที่รูปเดิมได้');
                    }
                    
                    uploadSection.classList.remove('hidden');
                } else {
                    uploadSection.classList.add('hidden');
                    showModal('error', 'ไม่พบข้อมูล', `ไม่พบรหัสใบจอง <strong>${searchId}</strong> ในระบบ`);
                }
            } catch (error) {
                console.error("Search error:", error);
                hideLoading();
                showModal('error', 'เกิดข้อผิดพลาด', 'ไม่สามารถค้นหาข้อมูลได้ กรุณาลองใหม่อีกครั้ง');
            }
        });

        // Image Compression function to stay under 1MB limit for Firestore doc
        function compressImage(file, callback) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    const MAX_WIDTH = 1000;
                    const MAX_HEIGHT = 1000;
                    let width = img.width;
                    let height = img.height;

                    if (width > height) {
                        if (width > MAX_WIDTH) {
                            height *= MAX_WIDTH / width;
                            width = MAX_WIDTH;
                        }
                    } else {
                        if (height > MAX_HEIGHT) {
                            width *= MAX_HEIGHT / height;
                            height = MAX_HEIGHT;
                        }
                    }
                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);
                    
                    // Compress to JPEG 0.7 quality
                    const dataUrl = canvas.toDataURL('image/jpeg', 0.7);
                    callback(dataUrl);
                }
                img.src = e.target.result;
            }
            reader.readAsDataURL(file);
        }

        const slipInput = document.getElementById('slip_file');
        const previewContainer = document.getElementById('preview_container');
        const slipPreview = document.getElementById('slip_preview');
        const dropZoneLabel = document.querySelector('label[for="slip_file"]');
        const submitSlipBtn = document.getElementById('submit_slip_btn');
        const removeBtn = document.getElementById('remove_slip_btn');

        function resetUploadState() {
            slipInput.value = '';
            compressedBase64 = null;
            previewContainer.classList.add('hidden');
            dropZoneLabel.classList.remove('hidden');
            submitSlipBtn.disabled = true;
        }

        slipInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                if (!file.type.startsWith('image/')) {
                    showAlert('กรุณาอัปโหลดไฟล์รูปภาพเท่านั้น', true);
                    return;
                }
                hideAlert();
                
                showLoading('กำลังประมวลผลรูปภาพ...');
                compressImage(file, (base64) => {
                    compressedBase64 = base64;
                    slipPreview.src = base64;
                    
                    dropZoneLabel.classList.add('hidden');
                    previewContainer.classList.remove('hidden');
                    submitSlipBtn.disabled = false;
                    
                    hideLoading();
                });
            }
        });

        removeBtn.addEventListener('click', resetUploadState);

        // Upload Slip Submit
        submitSlipBtn.addEventListener('click', async () => {
            if (!currentUploadBookingId || !compressedBase64 || !auth.currentUser) return;

            showLoading('กำลังอัปโหลดหลักฐาน...');

            try {
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'sponsorships', currentUploadBookingId);
                
                await updateDoc(docRef, {
                    slipImage: compressedBase64,
                    status: 'paid',
                    updatedAt: new Date().toISOString()
                });

                hideLoading();
                showModal('success', 'อัปโหลดสำเร็จ', 'ระบบได้รับหลักฐานการชำระเงินเรียบร้อยแล้ว ขอบคุณที่ให้การสนับสนุน', () => {
                    resetUploadState();
                    uploadSection.classList.add('hidden');
                    document.getElementById('search_booking_id').value = '';
                });

            } catch (error) {
                console.error("Upload error:", error);
                hideLoading();
                showModal('error', 'เกิดข้อผิดพลาด', 'ไม่สามารถอัปโหลดข้อมูลได้ (ไฟล์อาจมีขนาดใหญ่เกินไป)');
            }
        });

    </script>
