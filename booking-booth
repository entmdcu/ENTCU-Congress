                } else {
                    payDetails = `<p><strong>เช็คธนาคาร:</strong> ${formData.payment.cheque.bank} สาขา ${formData.payment.cheque.branch} <br>เลขที่: ${formData.payment.cheque.number} ลงวันที่: ${formData.payment.cheque.date}</p>`;
                }

                container.innerHTML = `
                    <div style="font-family: 'Prompt', sans-serif; padding: 40px; color: #333; max-width: 800px; margin: 0 auto;">
                        <div style="text-align: center; margin-bottom: 30px;">
                            <h2 style="color: #D685A9; font-size: 24px; margin: 0 0 10px 0;">ใบแสดงความจำนง การสนับสนุนการประชุมวิชาการ</h2>
                            <h3 style="font-size: 18px; margin: 0 0 5px 0;">the 3rd ENT CU Congress "Clinical practice Reimagined"</h3>
                            <p style="font-size: 14px; margin: 0; color: #555;">
                                ภาควิชา โสต ศอ นาสิกวิทยา คณะแพทยศาสตร์ จุฬาลงกรณ์มหาวิทยาลัย<br>
                                วันที่ 9-10 กุมภาพันธ์ 2570 ณ ชั้น 12 อาคารภูมิสิริ<br>
                                โรงพยาบาลจุฬาลงกรณ์ สภากาชาดไทย
                            </p>
                        </div>
                        
                        <div style="display: flex; justify-content: space-between; margin-bottom: 20px; border-bottom: 2px solid #D685A9; padding-bottom: 10px;">
                            <div style="font-size: 18px; font-weight: bold;">
                                รหัสใบจอง: <span style="color: #D685A9;">${bookingId}</span>
                            </div>
                            <div style="font-size: 14px; color: #666;">
                                วันที่ทำรายการ: ${dateStr}
                            </div>
                        </div>

                        <div style="margin-bottom: 25px; line-height: 1.8;">
                            <p><strong>ข้าพเจ้า:</strong> ${formData.contact.name} &nbsp;&nbsp;&nbsp; <strong>ตำแหน่ง:</strong> ${formData.contact.position}</p>
                            <p><strong>ในนามบริษัท:</strong> ${formData.contact.company}</p>
                            <p><strong>ที่อยู่:</strong> ${formData.contact.address}</p>
                            <p><strong>โทรศัพท์:</strong> ${formData.contact.phone} &nbsp;&nbsp;&nbsp; <strong>โทรสาร:</strong> ${formData.contact.fax || '-'} &nbsp;&nbsp;&nbsp; <strong>E-mail:</strong> ${formData.contact.email}</p>
                        </div>

                        <div style="margin-bottom: 25px; background-color: #fdf2f8; padding: 15px; border-radius: 8px;">
                            <h4 style="margin-top: 0; color: #b56d8e; font-size: 16px;">รายการสนับสนุน:</h4>
                            ${pkgDetails}
                            <div style="margin-top: 15px; border-top: 1px dashed #D685A9; padding-top: 10px; font-size: 18px; font-weight: bold; text-align: right;">
                                ยอดรวมทั้งสิ้น: <span style="color: #D685A9;">${totalAmount.toLocaleString()}</span> บาท
                            </div>
                        </div>

                        <div style="margin-bottom: 30px;">
                            <h4 style="margin-top: 0; font-size: 16px; border-bottom: 1px solid #ccc; padding-bottom: 5px;">วิธีการชำระเงินที่เลือก:</h4>
                            ${payDetails}
                        </div>

                        <div style="font-size: 12px; color: #666; text-align: center; border-top: 1px solid #eee; padding-top: 20px;">
                            <strong>กรุณาส่งใบแสดงความจำนง และหลักฐานการชำระเงิน มาที่:</strong><br>
                            คุณเกศแก้ว เกตุมณี เบอร์โทรศัพท์ 02-2564000 ต่อ 61724 / คุณรุ่งรัตน์ จำปาเงิน เบอร์โทรศัพท์ 02-2564000 ต่อ 61725
